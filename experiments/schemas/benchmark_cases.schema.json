{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRACE Benchmark Cases",
  "description": "Reproducible software issue cases. A valid schema does not establish benchmark quality or licensing rights.",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "repository_url",
          "base_commit",
          "issue",
          "split",
          "test_command",
          "expected_failing_tests",
          "relevant_files",
          "license",
          "provenance",
          "synthetic"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "repository_url": {
            "type": "string",
            "pattern": "^(https://|ssh://).+"
          },
          "base_commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": ["development", "validation", "test", "held_out"]
          },
          "test_command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_failing_tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "relevant_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
